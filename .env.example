# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://redblink.com
# WordPress origin for the blog proxy (blog and old post URLs keep working)
WORDPRESS_URL=
NEXT_PUBLIC_BLOG_URL=/blog/
# Contact form deliveries (Zapier/HubSpot/Slack webhook)
CONTACT_WEBHOOK_URL=
# Optional: live AI for the homepage solution architect
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── CMS (/admin) ─────────────────────────────────────────────────────
# Postgres connection string (Neon from the Vercel Marketplace sets POSTGRES_URL; either works)
DATABASE_URI=
# Long random string, e.g. `openssl rand -hex 32`. Never change it after launch (it signs logins).
PAYLOAD_SECRET=
# Image uploads in production (Vercel Blob store token)
BLOB_READ_WRITE_TOKEN=
# First administrator, created automatically on first start if no users exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Optional: separate secret for preview links (defaults to one derived from PAYLOAD_SECRET)
PREVIEW_SECRET=
